{
	"name": "@collab-api/server",
	"description": "plug & play collaboration backend",
	"version": "4.0.0",
	"homepage": "https://collab-api.dev",
	"keywords": [
		"collab-api",
		"yjs",
		"yjs-websocket",
		"prosemirror"
	],
	"license": "MIT",
	"type": "module",
	"main": "dist/collab-api-server.cjs",
	"module": "dist/collab-api-server.esm.js",
	"types": "dist/index.d.ts",
	"exports": {
		"source": {
			"import": "./src/index.ts"
		},
		"default": {
			"import": "./dist/collab-api-server.esm.js",
			"require": "./dist/collab-api-server.cjs",
			"types": "./dist/index.d.ts"
		}
	},
	"files": [
		"src",
		"dist"
	],
	"dependencies": {
		"@collab-api/common": "workspace:^",
		"async-mutex": "^0.5.0",
		"crossws": "^0.4.4",
		"kleur": "^4.1.4",
		"lib0": "^0.2.47"
	},
	"peerDependencies": {
		"y-protocols": "^1.0.6",
		"yjs": "^13.6.8"
	},
	"gitHead": "b3454a4ca289a84ddfb7fa5607a2d4b8d5c37e9d",
	"repository": {
		"url": "https://github.com/ueberdosis/collab-api"
	},
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
		"access": "public"
	}
}
