{
	"name": "@collab-api/transformer",
	"version": "4.0.0",
	"description": "collab-api transformation utilities",
	"homepage": "https://collab-api.dev",
	"keywords": [
		"collab-api",
		"transformer",
		"yjs"
	],
	"license": "MIT",
	"type": "module",
	"main": "dist/collab-api-transformer.cjs",
	"module": "dist/collab-api-transformer.esm.js",
	"types": "dist/index.d.ts",
	"exports": {
		"source": {
			"import": "./src/index.ts"
		},
		"default": {
			"import": "./dist/collab-api-transformer.esm.js",
			"require": "./dist/collab-api-transformer.cjs",
			"types": "./dist/index.d.ts"
		}
	},
	"files": [
		"src",
		"dist"
	],
	"dependencies": {
		"@tiptap/starter-kit": "^3.0.1"
	},
	"peerDependencies": {
		"@tiptap/core": "^3.0.1",
		"@tiptap/pm": "^3.0.1",
		"y-prosemirror": "^1.2.1",
		"yjs": "^13.6.8"
	},
	"devDependencies": {
		"@tiptap/pm": "^3.0.1"
	},
	"gitHead": "8f2e9df95de9968d70622ea8697c303a333b6cb3",
	"repository": {
		"url": "https://github.com/ueberdosis/collab-api"
	},
	"publishConfig": {
		"access": "public"
	}
}
