{
	"name": "@collab-api/provider",
	"version": "4.0.0",
	"description": "collab-api provider",
	"homepage": "https://collab-api.dev",
	"keywords": [
		"collab-api",
		"websocket",
		"provider",
		"yjs"
	],
	"license": "MIT",
	"type": "module",
	"main": "dist/collab-api-provider.cjs",
	"module": "dist/collab-api-provider.esm.js",
	"types": "dist/index.d.ts",
	"exports": {
		"source": {
			"import": "./src/index.ts"
		},
		"default": {
			"import": "./dist/collab-api-provider.esm.js",
			"require": "./dist/collab-api-provider.cjs",
			"types": "./dist/index.d.ts"
		}
	},
	"files": [
		"src",
		"dist"
	],
	"dependencies": {
		"@collab-api/common": "workspace:^",
		"@lifeomic/attempt": "^3.0.2",
		"lib0": "^0.2.87",
		"ws": "^8.17.1"
	},
	"peerDependencies": {
		"y-protocols": "^1.0.6",
		"yjs": "^13.6.8"
	},
	"gitHead": "cd788b6a315f608ef531524409abdce1e6790726",
	"repository": {
		"url": "https://github.com/ueberdosis/collab-api"
	},
	"publishConfig": {
		"access": "public"
	}
}
